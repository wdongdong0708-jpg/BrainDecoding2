{
  "schema_version": 1,
  "split": "val",
  "analysis_status": "exploratory_validation",
  "definitions": {
    "unit": "One existing displayed word position revisited at arrival minus word index equal to 1 or 2; model-seed repetitions are separate display events.",
    "cohort": "All actual delayed revisits in every held-out replay, including positions near segment tails with only one available revisit. Newly introduced current words and unchanged frozen positions are excluded.",
    "comparison": "Previous versus current k2_rolling display at the same annotated position. This is neither k0_frozen versus final k2_rolling nor Top-10 retrieval membership.",
    "correctness": "Exact equality with the annotated reference token at that position; no additional text normalization.",
    "wrong_to_right": "Displayed token changed from an incorrect token to its reference token.",
    "right_to_wrong": "Displayed token changed from its reference token to an incorrect token.",
    "wrong_to_wrong": "Displayed token changed between two distinct incorrect tokens.",
    "unchanged_correct": "Eligible revisit kept the already correct displayed token.",
    "unchanged_wrong": "Eligible revisit kept the same incorrect displayed token.",
    "changed_total": "wrong_to_right + right_to_wrong + wrong_to_wrong.",
    "eligible_revision_opportunities": "changed_total + unchanged_correct + unchanged_wrong. Per seed and delay d this equals sum(max(segment_word_count - d, 0)).",
    "net_correct_per_100_opportunities": "100 * (wrong_to_right - right_to_wrong) / eligible_revision_opportunities; a descriptive transition rate, not final accuracy.",
    "pooling": "Summing counts across seeds pools repeated model outputs, not independent participants. Use seed-wise rates to display seed variability; no inferential interval is exported.",
    "time": "input_window_end_seconds is the saved source signal-window end, measured on the source recording clock. Elapsed time subtracts target onset and includes the one-second signal window; it is not measured end-to-end processing latency.",
    "crop": "Zero-based crop_start inclusive and crop_stop exclusive. All displayed tokens and reference tokens retain source segmentation. Target_column is zero-based within the crop."
  },
  "validation": [
    "Replay causal arrival and frozen-prefix invariants checked.",
    "Every saved per-segment transition recomputed from consecutive rolling displays.",
    "Run-level display_transitions exactly matched.",
    "Opportunity denominators and category partitions checked.",
    "Net changes telescope from actual first rolling displays to final rolling displays.",
    "Validation cohorts, event table and complete decoding protocol identical across seeds within each dataset."
  ],
