{
  "schema_version": 1,
  "export_command": "python -m braindecoding.signal_control_revision_exports",
  "metric": "Exact equality between the actual displayed word at its annotated position and the reference token; not candidate Top-k accuracy.",
  "cohort": "For each dataset, retain target offsets i with i+2 below the evaluation-segment length. Identical target positions are used at initial display, +1 and +2 later word arrivals, across both conditions and all three trained-model seeds. The final two positions of each segment (or all positions for shorter segments) are excluded.",
  "initial_display": "The rolling decoder's own displayed token at arrival i; not the separately decoded k0_frozen strategy.",
  "gain_definition": "gain_pp = 100 * (correct at +2 arrivals - correct at initial display) / common_word_events.",
  "contrast_definition": "paired_real_minus_shift_gain_pp = real-signal gain_pp minus within-subject-shift gain_pp for the same trained-model seed and target positions.",
  "shift_definition": "The stored shifted control deranges neural score rows within each subject and maximum-available-horizon stratum. The same donor-row permutation is applied to neural scores at K0, K1 and K2 before candidate selection and the otherwise unchanged rolling beam decoder. This is an offline counterfactual control, not a temporally causal online signal shuffling scheme.",
  "shift_seed": 1729,
  "shift_repetitions": 1,
  "shift_audit": "Scheme checked in the current run_jayalath_stage2.shift_horizon_scores and candidate_recall.within_subject_permutation source code and matched against each stored protocol. Donor indices were not saved in these replay JSON files; donor assignments cannot be independently reconstructed from replay text alone.",
  "limitations": [
    "Model seeds 0, 1 and 2 share the same evaluation targets; they are not independent participants or independent word samples.",
    "Only one fixed signal permutation seed (1729) is present; seed variation does not estimate a signal-permutation distribution.",
    "Real-minus-shift gain is a descriptive control contrast, not pure neural information or a causal effect estimate.",
    "All outputs are validation replays with supplied word boundaries and a 250-word training-derived retrieval vocabulary; the test split was not used.",
    "The initial neural window lasts one second after word onset and may overlap subsequent annotated words. Arrival horizons do not establish strict real-time causal availability.",
    "No new inference, confidence intervals, hypothesis tests, or bootstrap calculations were performed for this export."
  ],
